{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salary-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SALARY_STORE",
        "class_name": "SalaryStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SalaryStore"]
    }
  ]
}
